# pgagent local config. Copy to config.yml and fill in your own credentials.
# Do NOT commit config.yml — it is git-ignored. Per BTSE security policy,
# do not share real credentials in shared environments or AI conversations.

databases:
  exg:
    host: 127.0.0.1
    port: 5432
    user: readonly
    password: ""
    dbname: lico
    sslmode: disable

  txn:
    host: 127.0.0.1
    port: 5432
    user: readonly
    password: ""
    dbname: txn
    sslmode: disable
